# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Server-only. No NEXT_PUBLIC_ prefix, so these are never sent to the browser.
# Only read these inside route handlers, server components, or server actions.

# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Optional model overrides. Defaults shown.
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# OPENAI_ANALYSIS_MODEL=gpt-4o-mini

# How sessions get scored.
#   llm   Real transcription and real structured rubric scoring. Production.
#   mock  No external API calls. Local UI and demo work.
# There is no automatic fallback: a failed analysis returns an error rather than
# quietly serving fabricated feedback about a real recording.
POISE_SCORING_MODE=llm

# Superseded by POISE_SCORING_MODE=mock. Still honored for compatibility.
POISE_USE_MOCK_ANALYSIS=false

# Firebase Admin service account.
# Firebase Console > Project Settings > Service accounts > Generate new private key.
# All three are server-only. Never add a NEXT_PUBLIC_ prefix to these.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com

# Paste the private key on one line with literal \n escapes, wrapped in quotes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# Secret for the scheduled prompt-generation route, /api/cron/daily-prompt.
# The route refuses every request when this is unset, so it fails closed rather
# than leaving prompt generation open to anyone who finds the URL.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# --- Browser-visible. The NEXT_PUBLIC_ prefix ships these to every visitor.
# These identify your Firebase project for sign-in. They are not secrets and are
# safe to expose: what protects your data is firestore.rules plus the fact that
# no browser writes to Firestore directly. Never put the service account key here.
# Firebase Console > Project Settings > General > Your apps > Web app > SDK setup.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# Local development only: point the Admin SDK at the Firestore emulator.
# When set, the three credentials above are ignored.
# Start it with: npx firebase-tools emulators:start --only firestore --project poise-dev
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
