# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Server-only. No NEXT_PUBLIC_ prefix, so these are never sent to the browser.
# Only read these inside route handlers, server components, or server actions.

# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Supabase > Project Settings > API > service_role.
# Bypasses row level security. Server-side only, always.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Public. Inlined into the client bundle at build time.
# Safe to expose: the anon key is designed for browser use and is
# constrained by row level security policies.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
