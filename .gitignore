# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
# Globs rather than an exact list, so a variant like .env.staging.local or a
# stray .env.backup is caught too. .env.example is the only one we ever commit.
.env
.env.*
!.env.example

# credentials
# Service account JSON from the Firebase console downloads under names like
# poise-9125d-firebase-adminsdk-abc12.json. Ignore the shapes, not one filename.
*-firebase-adminsdk-*.json
serviceAccount*.json
service-account*.json
*credentials*.json
gcp-key*.json
*.p12
*.pfx
*.key
!firestore.indexes.json

# recordings and scratch audio, which may contain someone speaking
*.webm
*.m4a
*.aiff
*.wav
!public/**/*.webm

# vercel
.vercel

# typescript
*.tsbuildinfo

# editor / os
.idea/
.vscode/*
!.vscode/extensions.json
Thumbs.db

# firebase emulator logs
firebase-debug.log
firestore-debug.log
ui-debug.log
*-debug.log
.firebase/

# Firebase CLI project alias. Holds the real project id, which is not a secret
# but is kept local so the project name stays off the public repo. Recreate it
# with: npx firebase-tools use --add
.firebaserc
